// Copy to Secrets.xcconfig (git-ignored) and fill in. Never put the secret/service-role key here.
// "//" starts a comment in xcconfig files, so the URL is written with $() between the slashes.
SUPABASE_URL = https:/$()/your-project.supabase.co
SUPABASE_ANON_KEY = sb_publishable_...
SUPABASE_EMAIL = you@example.com
SUPABASE_PASSWORD = your-password
